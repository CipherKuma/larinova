
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

ASSEMBLYAI_API_KEY=aai_xxxxx

RESEND_API_KEY=re_xxxxx

EMAIL_FROM=hello@larinova.com

NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_APP_NAME=Larinova

NODE_ENV=development

SARVAM_API_KEY=your_sarvam_api_key_here

# Deepgram (STT — Indonesia primary)
DEEPGRAM_API_KEY=

# STT streaming proxy — HMAC secret for short-lived browser STT tokens
STT_PROXY_SECRET=

# Analytics — HMAC secret used to hash client IPs before storage
ANALYTICS_IP_SECRET=

# STT debug logging — set to 1 locally to log transcription diagnostics.
# Leave UNSET in production (when set, verbose STT logs are emitted; no PHI).
DEBUG_STT=

# Razorpay (Live — fill from dashboard)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_PLAN_ID_PRO_MONTHLY=
RAZORPAY_PLAN_ID_PRO_YEARLY=

# MSG91 (SMS India — DLT-compliant)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE_IDS={}
# Shared secret for the MSG91 delivery-status webhook (sent as x-msg91-secret
# header or ?secret= query param). Unset = dev-mode open-accept; REQUIRED in prod.
MSG91_WEBHOOK_SECRET=

# Gupshup (WhatsApp Business)
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_NUMBER=
GUPSHUP_WEBHOOK_SECRET=

# Patient portal
NEXT_PUBLIC_PATIENT_PORTAL_URL=https://patient.larinova.com

# Dev simulation toggle — if =1, notify() logs instead of calling providers
SIMULATE_NOTIFY=

